<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for a MAC APP STORE build of Ticker.

  The App Store requires the App Sandbox, which BLOCKS the Accessibility APIs
  Ticker relies on. Under these entitlements the following features do NOT work
  and must be compiled out / hidden in the App Store variant:
    - keystroke / click counts (global event monitor)  -> Activity graph empty
    - window title / tab / project context (AXUIElement)

  What still works sandboxed: per-app usage time, productivity by category,
  focus goal, wellness breaks, and (with user consent) the screen timeline.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Save panels for CSV / PDF export. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- No network: Ticker is 100% on-device. (Intentionally omitted.) -->
</dict>
</plist>
